# Set one external-service key. scripts/start.py generates private local instance keys.
PRAMAAN_API_KEY=
PRAMAAN_BASE_URL=https://api.pramaan.dev
# Optional published URLs for your own deployment:
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8080
# Hosted domain attachment requires your existing Pramaan hosting project:
PRAMAAN_HOSTING_PROJECT=
# Captcha is off; no hosted widget is available. Local account/session auth is retained.
CAPTCHA_PROVIDER=none
BILLING_PROVIDER=none
