[Unit]
Description=ColdEmail tracking service (open pixels and click redirects)
Documentation=https://example.test/development/bare-metal/
After=network-online.target nats.service coldemail-backend.service
Wants=network-online.target

[Service]
Type=simple
User=coldemail
Group=coldemail
EnvironmentFile=/etc/coldemail/coldemail.env
WorkingDirectory=/opt/coldemail
ExecStart=/opt/coldemail/bin/tracking
Restart=always
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
