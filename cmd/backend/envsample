# it or instead of it. All optional: unset means errors are logged locally.

# SECRETS
# At least 32 characters: it signs every session token and the backend now
# refuses to start below that. Generate one with: make gen-key
AUTH_SECRET="replace-me-with-at-least-32-random-characters"

# Passkeys (WebAuthn). Optional — derived from APP_URL / CORS_ALLOW_ORIGINS
# when unset (and localhost for local dev). Override for self-hosting:
#   WEBAUTHN_RP_ID is the bare host (no scheme/port) passkeys bind to.
#   WEBAUTHN_RP_ORIGINS is a CSV of full origins allowed to run ceremonies.
# Changing the RP ID invalidates every enrolled passkey — keep it stable.
# WEBAUTHN_RP_ID="example.test"
# WEBAUTHN_RP_ORIGINS="https://example.test"
# WEBAUTHN_RP_DISPLAY_NAME="ColdEmail"

