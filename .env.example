# The only value you need to enter. make start generates private keys below.
PRAMAAN_API_KEY=

# Optional: leave these commented for local startup.
# PRAMAAN_BASE_URL=
# APP_URL=
# API_PUBLIC_URL=
# PRAMAAN_HOSTING_PROJECT=
# SOCIAL_PROVIDER_KEY=
# SOCIAL_CLIENT_ID=
# SOCIAL_AUTHORIZE_URL=
# SOCIAL_REDIRECT_URI=
# PRAMAAN_CONNECTOR_RETURN_URL=
# PRAMAAN_ENTERPRISE_REDIRECT_URI=
# PRAMAAN_FAKE=

# The notification sender uses DefaultSenderDomain in internal/notify/email.go.
# Optional owner address for notification replies only; this does not change the sender.
# EMAIL_ADDRESS=
